{% extends 'layout.html.twig' %}

{% block title %}Tableau de bord — La Ferme{% endblock %}

{% block body %}
    <main>
        <section class="hero">
            <div>
                <p class="eyebrow">Ferme de {{ login }}</p>
                <h1>Votre exploitation</h1>
                <p class="lede">Récoltez vos produits, améliorez vos bâtiments et faites prospérer la ferme.</p>
            </div>
            <dl class="stats">
                <div><dt>Produits</dt><dd>{{ products|length }}</dd></div>
                <div><dt>Bâtiments</dt><dd>{{ buildings|length }}</dd></div>
                <div><dt>Niveaux</dt><dd id="total-levels">{{ totalLevel }}</dd></div>
            </dl>
        </section>

        <section class="panel weather-panel" id="weather">
            <div class="weather-now">
                <span class="weather-icon" id="weather-icon" aria-hidden="true">🌡️</span>
                <div>
                    <p class="eyebrow">Météo à Lyon</p>
                    <h2 id="weather-condition">Chargement…</h2>
                    <p class="weather-meta">
                        <span id="weather-temperature">--</span> °C
                        · vent <span id="weather-wind">--</span> km/h
                    </p>
                </div>
            </div>
            <span class="weather-bonus" id="weather-bonus">×1,00</span>
            <p class="hint" id="weather-advice">La météo influence les récoltes.</p>
        </section>

        <p id="farm-status" class="farm-status" role="status" aria-live="polite"></p>

        <section class="panel" id="inventory">
            <header>
                <h2>Inventaire</h2>
                <span class="hint">Stock actuel</span>
            </header>
            <div class="product-grid">
                {% for product in products %}
                    <article id="product-{{ product.id }}" class="product-card">
                        <span class="icon" aria-hidden="true">{{ product.icon }}</span>
                        <div>
                            <h3>{{ product.name }}</h3>
                            <p>{{ product.unit }}</p>
                        </div>
                        <output class="stock" data-product="{{ product.id }}">{{ product.stock }}</output>
                    </article>
                {% endfor %}
            </div>
        </section>

        <section class="panel" id="buildings">
            <header>
                <h2>Bâtiments</h2>
                <span class="hint">Produire et améliorer</span>
            </header>
            <div class="building-grid">
                {% for building in buildings %}
                    <article id="building-{{ building.id }}" class="building-card">
                        <header>
                            <span class="icon" aria-hidden="true">{{ building.icon }}</span>
                            <div>
                                <h3>{{ building.name }}</h3>
                                <p>Produit : {{ building.produces.name }}</p>
                            </div>
                            <span class="level-badge">Niv. <output class="level">{{ building.level }}</output></span>
                        </header>

                        <p class="description">{{ building.description }}</p>

                        <div class="production">
                            Récolte : <strong>{{ building.yield }} {{ building.yieldUnit }}</strong>
                        </div>

                        <div class="actions">
                            <button class="harvest" type="button" data-building="{{ building.id }}">Produire</button>
                            <button class="upgrade" type="button" data-building="{{ building.id }}">Améliorer</button>
                        </div>

                        <output class="cost {{ building.canAfford ? 'affordable' : 'unaffordable' }}">
                            Coût : {% for part in building.costParts %}{{ part.icon }} {{ part.quantity }}{% if not loop.last %} · {% endif %}{% endfor %}
                        </output>
                    </article>
                {% endfor %}
            </div>
        </section>

        <section class="panel" id="live">
            <header>
                <h2>Fil de la ferme</h2>
                <span class="hint" id="live-status">
                    <span class="live-dot" aria-hidden="true"></span>
                    <span class="live-label">Connexion…</span>
                </span>
            </header>
            <ul id="live-feed" class="live-feed">
                {% for event in events %}
                    <li class="live-event" data-type="{{ event.type|default('world') }}">
                        <span class="event-time">{{ event.time }}</span>
                        <span class="event-type">{{ event.type|default('info') }}</span>
                        <span class="event-message">{{ event.message }}</span>
                    </li>
                {% else %}
                    <li class="live-empty">En attente d'événements…</li>
                {% endfor %}
            </ul>
        </section>
    </main>

    <script>
        window.FERME_PLAYER = {{ player|json_encode|raw }};
    </script>
    <script src="/Public/js/FermeEngine.js"></script>
    <script src="/Public/js/main.js"></script>
{% endblock %}
